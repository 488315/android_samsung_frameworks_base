<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topRightRadius="@dimen/media_output_dialog_active_background_radius" android:bottomRightRadius="@dimen/media_output_dialog_active_background_radius" />
            <solid android:color="@android:color/transparent" />
            <size android:height="@dimen/media_output_dialog_item_height" />
        </shape>
    </item>
    <item android:gravity="end|center" android:id="@id/contrast_dot" android:right="8.0dip">
        <shape android:shape="oval">
            <solid android:color="@color/media_dialog_seekbar_progress" />
            <size android:height="4.0dip" android:width="4.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/media_output_dialog_background_radius" />
                <size android:height="@dimen/media_output_dialog_item_height" />
                <solid android:color="@color/material_dynamic_primary80" />
            </shape>
        </clip>
    </item>
</layer-list>
